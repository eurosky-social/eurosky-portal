# Node
TZ=UTC
PORT=4075
HOST=127.0.0.1
NODE_ENV=development
APP_ENV=development

# App
LOG_LEVEL=info
APP_KEY=
APP_URL=http://${HOST}:${PORT}

# Session
SESSION_DRIVER=cookie

OAUTH_SERVICE=https://pds.rip/
MIGRATION_SERVICE=https://move.eurosky.tech/
ALLOW_EXTERNAL_LOGINS=true
# Handle domain(s) of accounts on `OAUTH_SERVICE`, comma-separated;
# the first one completes bare usernames (`alice` > `alice.bsky.social`)
ATPROTO_HANDLE_DOMAIN=bsky.social
# Milliseconds to resolve an identity, such as a custom handle (default: 5000)
# ATPROTO_RESOLVE_TIMEOUT=5000

# OAuth 2.0 server.
# OAUTH2_ALLOWED_DIDS=
# OAUTH2_CLIENT_CONNECT_URL=
# OAUTH2_CLIENT_ID=
# OAUTH2_CLIENT_NAME=
# OAUTH2_CLIENT_REDIRECT_URIS=
# OAUTH2_CLIENT_SECRET=

# OpenTelemetry, exported over OTLP to `OTEL_EXPORTER_OTLP_ENDPOINT`
OTEL_ENABLED=false

# Plausible for analytics
PLAUSIBLE_ENABLED=false
