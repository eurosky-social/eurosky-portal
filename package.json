{
  "name": "eurosky-portal",
  "version": "1.8.3",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": "^26.12.1"
  },
  "packageManager": "pnpm@12.14.0+sha512.c18ba6d87993d3d164cb5e8948f32b2c06ee854487e06cd8d86781342fb3e5bb4634367034711e86802baa9c37bea906ce1929ad08d70884c97d801df13389a6",
  "scripts": {
    "build": "node ace build",
    "changeset": "changeset",
    "dev": "node ace serve --hmr",
    "db:migrate": "node ace migration:run",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "i18n:check": "node ace i18n:check",
    "lex:build": "pnpm lex build --clear --indexFile --out ./app/lexicons --pretty",
    "lex": "./node_modules/.bin/lex",
    "lint": "eslint .",
    "release": "changeset publish",
    "start": "node bin/server.js",
    "test": "node ace test",
    "typecheck": "tsc --noEmit && tsc --noEmit --project inertia/tsconfig.json",
    "version-package": "changeset version"
  },
  "imports": {
    "#controllers/*": "./app/controllers/*.js",
    "#collections/*": "./app/collections/*.js",
    "#exceptions/*": "./app/exceptions/*.js",
    "#jobs/*": "./app/jobs/*.js",
    "#models/*": "./app/models/*.js",
    "#mails/*": "./app/mails/*.js",
    "#services/*": "./app/services/*.js",
    "#listeners/*": "./app/listeners/*.js",
    "#lexicons": "./app/lexicons/index.js",
    "#events/*": "./app/events/*.js",
    "#extensions/*": "./app/extensions/*.js",
    "#generated/*": "./.adonisjs/server/*.js",
    "#middleware/*": "./app/middleware/*.js",
    "#transformers/*": "./app/transformers/*.js",
    "#utils/*": "./app/utils/*.js",
    "#validators/*": "./app/validators/*.js",
    "#providers/*": "./providers/*.js",
    "#policies/*": "./app/policies/*.js",
    "#abilities/*": "./app/abilities/*.js",
    "#database/*": "./database/*.js",
    "#tests/*": "./tests/*.js",
    "#start/*": "./start/*.js",
    "#config/*": "./config/*.js",
    "#shared/*": "./shared/*.js"
  },
  "devDependencies": {
    "@adonisjs/assembler": "^8.6.0",
    "@adonisjs/eslint-config": "^3.1.0",
    "@adonisjs/prettier-config": "^1.5.0",
    "@adonisjs/tsconfig": "^2.0.0",
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@japa/assert": "^4.2.0",
    "@japa/browser-client": "^2.3.0",
    "@japa/plugin-adonisjs": "^5.2.0",
    "@japa/runner": "^5.4.0",
    "@poppinss/ts-exec": "^1.5.1",
    "@types/hast": "^3.0.5",
    "@types/luxon": "^3.7.6",
    "@types/node": "~26.6.5",
    "@types/proxy-addr": "^2.0.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "hot-hook": "^1.0.0",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "youch": "^4.1.1"
  },
  "dependencies": {
    "@adonisjs/auth": "^10.1.0",
    "@adonisjs/cache": "^2.1.0",
    "@adonisjs/content": "^1.7.1",
    "@adonisjs/core": "^7.6.0",
    "@adonisjs/cors": "^3.0.0",
    "@adonisjs/i18n": "^3.0.1",
    "@adonisjs/inertia": "^5.0.4",
    "@adonisjs/lucid": "^22.4.2",
    "@adonisjs/otel": "^1.2.4",
    "@adonisjs/queue": "^0.7.0",
    "@adonisjs/session": "^8.3.0",
    "@adonisjs/shield": "^9.0.0",
    "@adonisjs/static": "^2.0.1",
    "@adonisjs/vite": "^6.0.3",
    "@atcute/jetstream": "^2.2.0",
    "@atproto-labs/simple-store": "^0.5.1",
    "@atproto/jwk-jose": "^0.2.4",
    "@atproto/lex": "^0.4.0",
    "@atproto/oauth-client-node": "^0.5.10",
    "@atproto/syntax": "^0.7.7",
    "@formatjs/icu-messageformat-parser": "3.5.22",
    "@github/relative-time-element": "^5.3.1",
    "@headlessui/react": "^2.2.10",
    "@heroicons/react": "^2.2.0",
    "@inertiajs/core": "^3.9.1",
    "@inertiajs/react": "^3.9.1",
    "@tailwindcss/vite": "^4.3.3",
    "@thisismissem/adonisjs-atproto-oauth": "^3.0.4",
    "@tuyau/core": "^1.2.3",
