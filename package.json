{
  "name": "eurosky-portal",
  "version": "1.7.2",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": "^24.13.0"
  },
  "packageManager": "pnpm@12.4.1+sha512.2e81e399d73fe8390dab25e06aa788ab7a5908248d2f5a370f82b481147a6a7a367bf8048f9a6fdb6460f21a66f0542dedb8b94ca2c8723596741920b1656d4c",
  "scripts": {
    "start": "node bin/server.js",
    "build": "node ace build",
    "dev": "node ace serve --hmr",
    "db:migrate": "node ace migration:run",
    "test": "node ace test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit && tsc --noEmit --project inertia/tsconfig.json",
    "lex": "./node_modules/.bin/lex",
    "lex:build": "pnpm lex build --clear --indexFile --out ./app/lexicons",
    "changeset": "changeset",
    "release": "changeset publish",
    "version-package": "changeset version"
  },
  "imports": {
    "#controllers/*": "./app/controllers/*.js",
    "#collections/*": "./app/collections/*.js",
    "#exceptions/*": "./app/exceptions/*.js",
    "#jobs/*": "./app/jobs/*.js",
    "#models/*": "./app/models/*.js",
    "#mails/*": "./app/mails/*.js",
    "#services/*": "./app/services/*.js",
    "#listeners/*": "./app/listeners/*.js",
    "#lexicons": "./app/lexicons/index.js",
    "#events/*": "./app/events/*.js",
    "#extensions/*": "./app/extensions/*.js",
    "#generated/*": "./.adonisjs/server/*.js",
    "#middleware/*": "./app/middleware/*.js",
    "#transformers/*": "./app/transformers/*.js",
    "#utils/*": "./app/utils/*.js",
    "#validators/*": "./app/validators/*.js",
    "#providers/*": "./providers/*.js",
    "#policies/*": "./app/policies/*.js",
    "#abilities/*": "./app/abilities/*.js",
    "#database/*": "./database/*.js",
    "#tests/*": "./tests/*.js",
    "#start/*": "./start/*.js",
    "#config/*": "./config/*.js",
    "#shared/*": "./shared/*.js"
  },
  "devDependencies": {
    "@adonisjs/assembler": "^8.5.1",
    "@adonisjs/eslint-config": "^3.1.0",
    "@adonisjs/prettier-config": "^1.5.0",
    "@adonisjs/tsconfig": "^2.0.0",
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.2",
    "@japa/assert": "^4.2.0",
    "@japa/browser-client": "^2.3.0",
    "@japa/plugin-adonisjs": "^5.2.0",
    "@japa/runner": "^5.3.0",
    "@monocle.sh/cli": "^0.3.0",
    "@monocle.sh/studio": "^0.4.0",
    "@poppinss/ts-exec": "^1.4.4",
    "@types/hast": "^3.0.5",
    "@types/luxon": "^3.7.5",
    "@types/node": "~26.5.1",
    "@types/proxy-addr": "^2.0.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "hot-hook": "^1.0.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.6",
    "typescript": "~6.0.3",
    "vite": "^8.3.0",
    "youch": "^4.1.1"
  },
  "dependencies": {
    "@adonisjs/auth": "^10.1.0",
    "@adonisjs/cache": "^2.1.0",
    "@adonisjs/content": "^1.7.1",
    "@adonisjs/core": "^7.5.0",
    "@adonisjs/cors": "^3.0.0",
    "@adonisjs/i18n": "^3.0.1",
    "@adonisjs/inertia": "^5.0.1",
    "@adonisjs/lucid": "^22.4.2",
    "@adonisjs/queue": "^0.6.2",
    "@adonisjs/session": "^8.1.0",
    "@adonisjs/shield": "^9.0.0",
    "@adonisjs/static": "^2.0.1",
    "@adonisjs/vite": "^6.0.2",
    "@atproto-labs/simple-store": "^0.5.1",
    "@atproto/jwk-jose": "^0.2.4",
    "@atproto/lex": "^0.3.11",
    "@atproto/oauth-client-node": "^0.5.7",
    "@atproto/syntax": "^0.7.6",
    "@formatjs/icu-messageformat-parser": "3.5.18",
    "@github/relative-time-element": "^5.3.1",
    "@headlessui/react": "^2.2.10",
    "@heroicons/react": "^2.2.0",
    "@inertiajs/core": "^3.7.1",
    "@inertiajs/react": "^3.7.1",
    "@monocle.sh/adonisjs-agent": "1.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@thisismissem/adonisjs-atproto-oauth": "^3.0.4",
    "@tuyau/core": "^1.2.2",
    "@vinejs/vine": "^4.4.0",
    "bcp-47-match": "^2.0.3",
    "better-sqlite3": "^13.0.3",
    "clsx": "^2.1.1",
    "edge-markdown": "^1.10.2",
    "edge.js": "^6.5.1",
    "hast-util-sanitize": "^5.0.2",
    "hast-util-to-jsx-runtime": "^2.3.6",
    "hast-util-truncate": "^2.0.0",
    "intl-messageformat": "^11.2.15",
    "lucide-react": "^1.45.0",
    "luxon": "^3.7.2",
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-to-hast": "^13.2.1",
    "micromark-util-sanitize-uri": "^2.0.1",
    "motion": "^13.2.0",
    "proxy-addr": "^2.0.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "reflect-metadata": "^0.2.2",
    "sonner": "^2.0.8",
    "tailwindcss": "^4.3.3"
  },
  "hotHook": {
    "boundaries": [
      "./app/controllers/**/*.ts",
      "./app/middleware/*.ts"
    ]
  },
  "prettier": "@adonisjs/prettier-config"
}
