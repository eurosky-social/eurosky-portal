{
  "name": "eurosky-portal",
  "version": "1.9.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": "^26.12.1"
  },
  "packageManager": "pnpm@12.14.0+sha512.c18ba6d87993d3d164cb5e8948f32b2c06ee854487e06cd8d86781342fb3e5bb4634367034711e86802baa9c37bea906ce1929ad08d70884c97d801df13389a6",
  "scripts": {
    "build": "node ace build",
    "changeset": "changeset",
    "dev": "node bin/dev.ts",
    "db:migrate": "node ace migration:run",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "lex:build": "pnpm lex build --clear --import-ext .ts --indexFile --out ./app/lexicons --pretty",
    "lex": "./node_modules/.bin/lex",
    "lint": "eslint .",
    "release": "changeset publish",
    "start": "node bin/server.js",
    "test": "c8 sh -c 'node --run test:plain && node --run test:adonis'",
    "test:adonis": "node bin/test.ts",
    "test:plain": "node --import ./tests/env.ts --test 'tests/**/*.test.ts'",
    "typecheck": "tsc --noEmit && tsc --noEmit --project inertia/tsconfig.json && tsc --project tests/inertia/tsconfig.json",
    "version-package": "changeset version"
  },
  "imports": {
    "#*": "./app/*.ts",
    "#generated/*": "./.adonisjs/server/*.ts"
  },
  "devDependencies": {
    "@adonisjs/assembler": "^8.6.0",
    "@adonisjs/eslint-config": "^3.1.0",
    "@adonisjs/prettier-config": "^1.5.0",
    "@adonisjs/tsconfig": "^2.0.0",
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@japa/api-client": "^3.2.1",
    "@japa/assert": "^4.2.0",
    "@japa/browser-client": "^2.3.0",
    "@japa/plugin-adonisjs": "^5.2.0",
    "@japa/runner": "^5.4.0",
    "@types/hast": "^3.0.5",
    "@types/luxon": "^3.7.6",
    "@types/node": "~26.6.6",
    "@types/proxy-addr": "^2.0.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "c8": "^12.0.0",
    "eslint": "^10.14.0",
    "hot-hook": "^1.1.0",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "vite": "^8.3.7",
    "youch": "^4.1.1"
  },
  "dependencies": {
    "@adonisjs/auth": "^10.1.0",
