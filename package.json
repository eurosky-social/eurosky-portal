    "@inertiajs/react": "^3.11.0",
    "@remix-run/multipart-parser": "^1.1.1",
    "@tailwindcss/vite": "^4.3.5",
    "@thisismissem/adonisjs-atproto-oauth": "^3.0.4",
    "@tuyau/core": "^1.3.0",
    "@vinejs/vine": "^4.4.0",
    "better-sqlite3": "^13.0.3",
    "clsx": "^2.1.1",
    "edge.js": "^6.5.1",
    "hast-util-from-html": "^2.1.0",
    "hast-util-sanitize": "^5.0.2",
    "hast-util-to-jsx-runtime": "^2.3.7",
    "hast-util-to-string": "^3.0.1",
    "hast-util-truncate": "^2.0.0",
    "intl-messageformat": "^12.1.5",
    "lucide-react": "^1.70.0",
    "luxon": "^3.7.2",
    "mdast-util-from-markdown": "^2.1.0",
    "mdast-util-to-hast": "^13.2.1",
    "micromark-util-sanitize-uri": "^2.0.1",
    "motion": "^14.11.0",
    "proxy-addr": "^2.0.8",
