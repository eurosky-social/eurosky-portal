    "@adonisjs/queue": "^0.7.0",
    "@adonisjs/session": "^8.3.0",
    "@adonisjs/shield": "^9.0.0",
    "@adonisjs/static": "^2.0.1",
    "@adonisjs/vite": "^6.0.4",
    "@atcute/jetstream": "^2.2.1",
    "@atcute/tid": "^1.1.4",
    "@atproto-labs/simple-store": "^0.5.1",
